NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/enterprise_hrms

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRY=7d

# Redis (optional in dev — app works fine with this set to false)
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# Cloudinary (optional in dev — uploads are skipped gracefully if unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional in dev — emails are logged to console if disabled)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Enterprise HRMS <no-reply@hrms.local>"

# Frontend URL (used in emails / CORS)
CLIENT_URL=http://localhost:5173
