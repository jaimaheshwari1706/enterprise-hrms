NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/enterprise_hrms

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRY=7d

# Redis (optional in dev — app works fine with this set to false)
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# Cloudinary (optional in dev — uploads are skipped gracefully if unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional in dev — emails are logged to console if disabled)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Enterprise HRMS <no-reply@hrms.local>"

# Frontend URL (used to build links in emails, e.g. password reset)
CLIENT_URL=http://localhost:5173

# Comma-separated list of origins allowed to call the API with credentials.
# Falls back to CLIENT_URL above if unset. In production, list every origin
# the frontend is actually served from (e.g. prod domain + Vercel preview URL).
CORS_ORIGINS=http://localhost:5173
