# Copy to .env for local development. Never commit the real .env file.

NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# MongoDB — local docker/compose instance, or a MongoDB Atlas SRV URI.
MONGO_URI=mongodb://127.0.0.1:27017/enterprise_hrms

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production refuses to start unless both are set, >= 32 chars, and different.
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_characters_long
JWT_REFRESH_EXPIRY=7d

# Business timezone: decides which calendar day a check-in / leave day
# belongs to. Any IANA name (Asia/Kolkata, UTC, Europe/London, ...).
APP_TIMEZONE=Asia/Kolkata

# Per-account login lockout (independent of the per-IP rate limiter), and the
# refresh-token rotation grace window (seconds) that tolerates a lost
# rotation response — 0 makes any reuse revoke the whole session family.
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_REFRESH_REUSE_GRACE_SECONDS=30

# Redis (optional — app works fine with this set to false)
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# Cloudinary (optional — image uploads return 503 until configured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional — when disabled, emails are logged to the console in dev)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Enterprise HRMS <no-reply@hrms.local>

# Frontend URL (used to build links in emails, e.g. password reset)
CLIENT_URL=http://localhost:5173

# Comma-separated list of origins allowed to call the API with credentials.
# Falls back to CLIENT_URL if unset. In production list every origin the
# frontend is served from (prod domain + Vercel preview URL).
CORS_ORIGINS=http://localhost:5173
