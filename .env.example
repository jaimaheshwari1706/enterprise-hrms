# Used by docker-compose.yml to override defaults for the `server` service.
# Copy to .env in the project root before running `docker compose up` for
# anything beyond local experimentation — the built-in defaults are NOT
# safe for a real deployment.

JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Enterprise HRMS <no-reply@hrms.local>
